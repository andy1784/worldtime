{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "worldtime",
  "compatibility_date": "2025-09-27",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "world time Kimi_Agent_Deployment_v3",
    "browser_TTL": 31536000,
    "serve_single_page_app": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "single-page-application"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "rules": [
    {
      "type": "ESModule",
      "globs": ["**/*.js"],
      "fallthrough": true
    }
  ],
  "cache": {
    "rules": [
      {
        "match": "^/assets/.*\\.(js|css)$",
        "cacheTtl": 31536000,
        "edgeTtl": 31536000,
        "bypassCacheOnCookie": false
      },
      {
        "match": "^/.*\\.(png|jpg|jpeg|gif|svg|ico|webp)$",
        "cacheTtl": 31536000,
        "edgeTtl": 31536000
      },
      {
        "match": "^/api/.*",
        "cacheTtl": 300,
        "edgeTtl": 300,
        "respectOriginResponseHeaders": true
      }
    ]
  },
  "headers": [
    {
      "match": "^/assets/.*\\.(js|css)$",
      "set": {
        "Cache-Control": "public, max-age=31536000, immutable",
        "Access-Control-Allow-Origin": "*"
      }
    },
    {
      "match": "^/index\\.html$",
      "set": {
        "Cache-Control": "public, max-age=0, must-revalidate"
      }
    },
    {
      "match": "^/sw\\.js$",
      "set": {
        "Cache-Control": "no-cache, no-store, must-revalidate",
        "Service-Worker-Allowed": "/"
      }
    },
    {
      "match": "^/manifest\\.json$",
      "set": {
        "Cache-Control": "public, max-age=86400",
        "Content-Type": "application/manifest+json"
      }
    }
  ],
  "minify": true,
  "compress": true
}
