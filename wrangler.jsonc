{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "worldtime",
  "compatibility_date": "2025-09-27",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "world time Kimi_Agent_Deployment_v3",
    "browser_TTL": 31536000,
    "serve_single_page_app": true
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "rules": [
    {
      "type": "ESModule",
      "globs": ["**/*.js"],
      "fallthrough": true
    }
  ]
}
